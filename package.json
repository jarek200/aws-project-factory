{
  "name": "aws-project-factory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "pnpm -r exec -- rm -rf node_modules .turbo 2>/dev/null || true && rm -rf node_modules .turbo",
    "build": "turbo run build",
    "dev": "pnpm sst dev",
    "dev:local": "pnpm --filter @admin/web dev",
    "dev:admin": "pnpm --filter @admin/web dev",
    "deploy": "pnpm sst deploy --stage admin",
    "remove": "pnpm sst remove --stage admin",
    "sso": "aws sso login --sso-session=acme",
    "lint": "pnpm exec biome check .",
    "lint:fix": "pnpm exec biome check . --write",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:turbo": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "codegen": "turbo run codegen",
    "codegen:watch": "pnpm --filter @admin/graphql codegen:watch",
    "prepare": "husky",
    "verify": "pnpm codegen && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "project-factory",
    "aws-organizations",
    "sst",
    "svelte",
    "sveltekit",
    "aws",
    "appsync",
    "graphql",
    "dynamodb",
    "cognito",
    "turborepo",
    "monorepo",
    "typescript"
  ],
  "license": "MIT",
  "description": "Self-hosted AWS and GitHub project factory control plane",
  "repository": {
    "type": "git",
    "url": "https://github.com/jarek200/aws-project-factory"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@pulumi/aws": "^7.55.0",
    "@pulumi/pulumi": "^3.277.0",
    "@sveltejs/adapter-auto": "^9.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "sst": "npm:@sst-community/sst@4.25.0",
    "turbo": "^2.11.13",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.20.0"
}
