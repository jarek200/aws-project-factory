# Copy to a shell profile or export before `pnpm run deploy`.
# Do not commit a filled-in .env.

# AWS CLI profile for the admin / management account.
AWS_PROFILE_ADMIN=acme-admin

# GitHub App private key secret. Default name is /admin-factory/github-private-key
# in the admin account. Set this only to override the ARN.
# GITHUB_PRIVATE_KEY_SECRET_ARN=

# Default template shown in the new-project form (owner/repo). Leave empty to type it each time.
VITE_DEFAULT_TEMPLATE_REPO=

# Plus-address for vended AWS accounts: local+slug-suffix@domain
VITE_ACCOUNT_EMAIL_LOCAL=
VITE_ACCOUNT_EMAIL_DOMAIN=

# Optional SSO portal link in the admin navbar.
VITE_SSO_URL=

# Optional custom DNS. Set both, or neither.
# FACTORY_ROOT_DOMAIN=example.com
# FACTORY_ADMIN_HOSTED_ZONE_ID=Z00000000000000000000

# Required for SST stages other than `admin` after the apps zone exists.
# PROJECT_APPS_HOSTED_ZONE_ID=

# Identity Center (optional overrides; group id itself lives in SSM).
# IDENTITY_CENTER_PERMISSION_SET_NAME=AdministratorAccess
# IDENTITY_CENTER_GROUP_DISPLAY_NAME=
# IDENTITY_CENTER_REGION=
# IDENTITY_CENTER_SKIP_ASSIGNMENT=
